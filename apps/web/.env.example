# CareerGPS Frontend Configuration (Vercel / Production Deployment)

# Backend FastAPI URL (Render / Cloud endpoint in production, e.g. https://careergps-api.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:8005/api

# Supabase Auth Configuration (Production Project URL & Anon Public Key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostHog Product Telemetry (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
