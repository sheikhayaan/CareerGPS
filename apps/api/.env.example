# CareerGPS Backend API Configuration Example
PROJECT_NAME="CareerGPS API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # Use "production" in deployed cloud, "development" locally

# Database Configuration (PostgreSQL with PgBouncer connection pooling in production)
DATABASE_URL="postgresql://careergps_user:your_password@ep-sample-1234.us-east-1.aws.neon.tech/careergps?sslmode=require"

# High-concurrency connection pooling (PostgreSQL)
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis configuration for cache & rate limiting
REDIS_URL="redis://default:your_redis_password@your-redis-host:6379/0"

# CORS Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS='["https://careergps.vercel.app","http://localhost:3000"]'

# Adzuna API (Optional for automated job ingestion)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Supabase Auth Configuration (Production Project JWT Secret)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_JWT_SECRET="your-production-supabase-jwt-secret"

# PostHog Analytics Configuration (Optional)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Admin API Key for internal product analytics
ADMIN_API_KEY="generate-a-strong-random-64-char-token"
