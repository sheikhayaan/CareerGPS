# CareerGPS Backend API Configuration Example
PROJECT_NAME="CareerGPS API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL="sqlite:///./careergps.db"

# Adzuna API (Optional for automated job ingestion)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Supabase Auth Configuration (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_JWT_SECRET="local-development-secret-key-change-in-production"

# Admin API Key for internal product analytics
ADMIN_API_KEY="careergps-internal-admin-sec-key-2026"
